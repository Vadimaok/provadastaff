{
  "name": "provoda-staff-desktop",
  "version": "1.0.9",
  "description": "Provoda Staff desktop app for Windows",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.knz.provodastaff",
    "productName": "Provoda Staff",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "provoda-icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "provoda-icon.ico"
    },
    "artifactName": "Provoda-Staff-${version}.${ext}"
  }
}